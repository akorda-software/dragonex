#!/usr/bin/env sh
# bin/dev — arranca Phoenix en dev cargando .env.dev ANTES de evaluar mix.exs.
#
# mix.exs usa ../exAgent y ../dic_ex en dev/test, y Hex en prod. Este wrapper
# carga credenciales y rutas personalizadas antes de evaluar el proyecto.
#
# Uso:
#   bin/dev                       # arranca Phoenix con los paquetes hermanos
#   MIX_ENV=test bin/dev test     # suite offline con los paquetes hermanos
#   MIX_ENV=test DRAGONEX_DEPS_SOURCE=hex bin/dev test # grafo publicado
#
# Carga .env.dev si existe (set -a exporta todas las vars definidas después).
# .env.dev carga la configuración local; los selectores de dependencias y
# MIX_ENV explícitos del shell prevalecen sobre el archivo.

set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="${DRAGONEX_ENV_FILE:-$ROOT/.env.dev}"
DEPS_ROOT_OVERRIDE="${DRAGONEX_DEPS_ROOT-}"
DEPS_SOURCE_OVERRIDE="${DRAGONEX_DEPS_SOURCE-}"
MIX_ENV_OVERRIDE="${MIX_ENV-}"

if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi

[ -z "$DEPS_ROOT_OVERRIDE" ] || export DRAGONEX_DEPS_ROOT="$DEPS_ROOT_OVERRIDE"
[ -z "$DEPS_SOURCE_OVERRIDE" ] || export DRAGONEX_DEPS_SOURCE="$DEPS_SOURCE_OVERRIDE"
[ -z "$MIX_ENV_OVERRIDE" ] || export MIX_ENV="$MIX_ENV_OVERRIDE"

cd "$ROOT"
if [ "$#" -eq 0 ]; then set -- phx.server; fi
exec mix "$@"
