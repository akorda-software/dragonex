# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
dragones-*.tar


.env
.env.dev
.env.dokploy
!.env.dev.example
!.env.dokploy.example

# Vendored dic_ex dice assets (JS bundle + CSS) — copied from the ../dic_ex
# path dep via `mix dic_ex.install` (or `cp ../dic_ex/priv/static/* priv/static/assets/`).
# Build artifacts, not source; regenerate after upgrading dic_ex.
# The app's own stylesheets, fonts and sprites (D84) live alongside them and
# ARE source, so they are re-included explicitly.
/priv/static/assets/*
!/priv/static/assets/dragonex.css
!/priv/static/assets/game.css
!/priv/static/assets/wizard.css
!/priv/static/assets/favicon.svg
!/priv/static/assets/wordmark.svg
!/priv/static/assets/fonts/
!/priv/static/assets/sprites/

# SRD importer cache (regenerable via scripts/import_srd_spells.py)
/priv/srd/.cache/

# Python bytecode
__pycache__/
*.pyc
.impeccable/
.hex_graph/
