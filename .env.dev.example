# .env.dev.example — Plantilla de DESARROLLO LOCAL.
# Copia a .env.dev y ajusta lo que toque. .env.dev está gitignored.
#
# Responsabilidades (separación de entornos):
#   .env.dev        -> desarrollo local (este archivo). Lo carga Dotenvy en :dev
#                      y :test (config/runtime.exs) y también compose.dev.yml
#                      (env_file del servicio `app`).
#   .env.dokploy    -> despliegue en Dokploy (producción). Plantilla en
#                      .env.dokploy.example.
#   .env            -> reserva para simular producción en local si hace falta
#                      (no se carga automáticamente en :dev; háblalo antes).
#
# Escenario previsto: phoenix levantado EN EL HOST contra el Postgres que expone
# compose.dev.yml en el puerto host 5455.
#   docker compose -f compose.dev.yml up -d postgres
#   bin/dev          -> http://localhost:4035
#
# Si levantas la app DENTRO de compose (servicio `app`), DB_HOST, DB_PORT y
# PHX_BIND_IP los sobreescribe el propio compose.dev.yml (environment:
# DB_HOST=postgres, DB_PORT=5432, PHX_BIND_IP=0.0.0.0); aquí solo son relevantes
# DB_USER, DB_PASS, DB_NAME y los secretos de la app (OPENROUTER_API_KEY...).

# --- Postgres (compose.dev.yml: host 5455 -> contenedor 5432) ---
DB_HOST=127.0.0.1
DB_PORT=5455
DB_USER=postgres
DB_PASS=postgres
DB_NAME=dragonex_dev
# MIX_ENV=test ignora DB_NAME y usa dragonex_test. Para una base de pruebas
# distinta, configura DB_TEST_NAME (nunca hereda la base de desarrollo).
# DB_TEST_NAME=dragonex_test

# --- Deps locales: ../exAgent (A mayúscula) y ../dic_ex ---
# Dev/test siempre usa las carpetas hermanas, sin flag ni fallback a GitHub.
# bin/dev carga este archivo antes de evaluar mix.exs. Compose dev las monta.
# Producción siempre usa Hex y mix.hex.lock. Para probar el grafo publicado:
#   MIX_ENV=test DRAGONEX_DEPS_SOURCE=hex bin/dev test
# Opcional: otro directorio que contenga exAgent y dic_ex.
# DRAGONEX_DEPS_ROOT=../

# --- Phoenix (dev) ---
# Puerto de la app en host; Compose usa 4000 interno y 4035 en loopback del host.
PORT=4035
PHX_BIND_IP=127.0.0.1

# --- IA / proveedor de modelos ---
# Selector de proveedor: openrouter (default) | opencode (OpenCode Zen/Go).
# Cambiar esto intercambia el gateway, la API key y los IDs de modelo por
# defecto. Véase lib/dragonex/models.ex para el detalle.
DRAGONEX_PROVIDER=openrouter
# En dev el modal Ajustes de IA deja elegir cualquier modelo con estas claves.
# =fixed simula producción: la casa solo paga DeepSeek v4.1 Flash (D242).
# DRAGONEX_SERVER_MODELS=fixed

# --- OpenRouter (pay-per-token) ---
# Solo se usa cuando DRAGONEX_PROVIDER=openrouter. Sin clave, models.ex usa
# TestModel (no consume créditos). Pon tu clave para un DM real.
OPENROUTER_API_KEY=
# Modelos y tuning (todos con defaults; descomenta para sobrescribir):
# DRAGONEX_MODEL=deepseek/deepseek-v4-flash
# DRAGONEX_SUMMARIZER_MODEL=google/gemini-3.1-flash-lite
# Orden preferido de los upstream providers de OpenRouter (CSV de slugs en
# minúscula, ver https://openrouter.ai/docs/features/provider-routing).
# Vacío/unset = routing por defecto de OpenRouter. Sólo aplica con
# DRAGONEX_PROVIDER=openrouter. Ej:
# OPENROUTER_PROVIDER_ORDER=deepinfra,relace,wafer,together,baseten

# --- OpenCode Go / Zen ---
# Solo se usa cuando DRAGONEX_PROVIDER=opencode. Hay DOS planes con endpoints
# distintos (mismo host, misma API):
#   - Go  (suscripción flat-rate, $10/mes, cuotas)  -> https://opencode.ai/zen/go/v1
#   - Zen (pay-as-you-go, saldo prepago)            -> https://opencode.ai/zen/v1
# OPENCODE_PLAN selecciona el endpoint (go | zen). Por defecto "go".
# ¡La clave debe corresponder al plan! (clave Go contra endpoint Zen = CreditsError).
# Consigue tu clave en https://opencode.ai/auth (OpenCode Go o Zen).
OPENCODE_PLAN=go
OPENCODE_API_KEY=
# IDs de modelo de Zen (slugs sin prefijo, ej. deepseek-v4-flash, glm-5.2,
# gemini-3.5-flash-lite). Defaults:
# DRAGONEX_MODEL=deepseek-v4-flash
# DRAGONEX_SUMMARIZER_MODEL=gemini-3.5-flash-lite

# DRAGONEX_APP_TITLE=dragonex
# DRAGONEX_DM_MAX_TOKENS=1500
# TurnMaster: presupuesto por petición, incluye razonamiento del proveedor.
# Entero positivo; vacío/inválido conserva 1024. Se aplica al arrancar el Game.
# DRAGONEX_TURNMASTER_MAX_TOKENS=1024

# SECRET_KEY_BASE NO hace falta en dev: config/dev.exs hardcodea uno de dev.
# (Producción lo inyecta Dokploy vía DATABASE_URL / SECRET_KEY_BASE.)

# Proveedores de OpenRouter para deepseek/deepseek-v4.1-flash (CSV estricto,
# sin alternativas). Por defecto decart. Para ver la narración en vivo hace
# falta uno que trocee los argumentos de las tools, p. ej. fireworks (D234).
# DRAGONEX_DEEPSEEK_PROVIDERS=fireworks
