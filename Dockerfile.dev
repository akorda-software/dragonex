# Imagen de desarrollo para compose.dev.yml. No es la de producción (ver Dockerfile):
# monta el source y arranca mix phx.server con code reload.
FROM hexpm/elixir:1.20.2-erlang-29.0.2-alpine-3.24.1

# build-base: compilar NIFs (bcrypt_elixir). inotify-tools: file watching live reload.
# Los paquetes propios se montan desde sus carpetas hermanas.
RUN apk add --no-cache build-base inotify-tools git

WORKDIR /app

ENV MIX_ENV=dev
ENV LANG=C.UTF-8

RUN mix local.hex --force && mix local.rebar --force

CMD ["mix", "phx.server"]
