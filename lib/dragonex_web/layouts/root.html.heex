<!DOCTYPE html>
<html lang={Atom.to_string(Dragonex.I18n.locale())}>
  <head>
    <meta charset="utf-8" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dragonex</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/assets/fonts/departure-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/jacquarda-bastarda-9.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/dic_ex.css" />
    <link rel="stylesheet" href="/assets/dragonex.css" />
    <link rel="stylesheet" href="/assets/game.css" />
    <link rel="stylesheet" href="/assets/wizard.css" />
    <script defer src="/assets/dic_ex.min.js"></script>
    <script type="module">
      import { Socket } from "/assets/phoenix.mjs";
      import { LiveSocket } from "/assets/phoenix_live_view.esm.js";

      const csrfToken = document
        .querySelector("meta[name='csrf-token']")
        .getAttribute("content");

      // dic_ex ships its LiveView hooks (DiceRoller 3D, DiceRoller2D) on
      // window.DicExHooks via the deferred bundle above. If it failed to load
      // the hooks are simply absent (the phx-hook attrs become no-ops).
      // AutoScroll keeps the chat log pinned to the newest line, but only when
      // the reader is already near the bottom so scrolling back to read history
      // is not yanked away.
      const hooks = {
        ...(window.DicExHooks || {}),
        AutoScroll: {
          mounted() {
            this.following = true;
            this.jump = this.el.parentElement.querySelector("#jump-latest");
            this.track = () => {
              this.following = this.el.scrollHeight - this.el.scrollTop - this.el.clientHeight < 80;
              if (this.jump) this.jump.hidden = this.following;
            };
            this.latest = () => {
              this.following = true;
              this.el.scrollTop = this.el.scrollHeight;
              this.track();
            };
            this.el.addEventListener("scroll", this.track, { passive: true });
            this.jump?.addEventListener("click", this.latest);
            this.resize = new ResizeObserver(() => {
              if (this.following) this.latest();
            });
            this.resize.observe(this.el);
            this.latest();
            // Font metrics and responsive layout can create overflow after
            // mount. Keep following only while the reader stays at the end.
            document.fonts.ready.then(() => {
              if (this.el.isConnected && this.following) this.latest();
            });
          },
          beforeUpdate() {
            this.wasFollowing = this.following;
            const top = this.el.getBoundingClientRect().top;
            const anchor = Array.from(this.el.querySelectorAll("[data-log-entry]"))
              .find(el => el.getBoundingClientRect().bottom >= top);
            this.anchor = anchor && { id: anchor.id, offset: anchor.getBoundingClientRect().top - top };
          },
          updated() {
            if (this.wasFollowing) {
              this.latest();
            } else if (this.anchor) {
              const anchor = this.el.querySelector(`#${CSS.escape(this.anchor.id)}`);
              if (anchor) {
                this.el.scrollTop += anchor.getBoundingClientRect().top
                  - this.el.getBoundingClientRect().top - this.anchor.offset;
              }
              this.track();
            }
          },
          destroyed() {
            this.resize.disconnect();
            this.el.removeEventListener("scroll", this.track);
            this.jump?.removeEventListener("click", this.latest);
          }
        },
        TurnControls: {
          mounted() {
            this.revealFocused = event => {
              const button = event.target.closest(".ctl-btn");
              if (!button || !this.el.contains(button)) return;
              const strip = this.el.getBoundingClientRect();
              const bounds = button.getBoundingClientRect();
              const inset = 7; // Keep the pixel focus outline inside the strip.
              const left = strip.left + inset;
              const right = strip.left + this.el.clientWidth - inset;
              if (bounds.left < left) this.el.scrollLeft += bounds.left - left;
              else if (bounds.right > right) this.el.scrollLeft += bounds.right - right;
            };
            this.el.addEventListener("focusin", this.revealFocused);
            // The faded edge hints at hidden controls until the strip ends.
            this.sync = () => {
              const end = this.el.scrollLeft + this.el.clientWidth >= this.el.scrollWidth - 2;
              this.el.classList.toggle("at-end", end);
            };
            this.el.addEventListener("scroll", this.sync, {passive: true});
            window.addEventListener("resize", this.sync);
            this.sync();
          },
          updated() { this.sync(); },
          destroyed() {
            this.el.removeEventListener("focusin", this.revealFocused);
            this.el.removeEventListener("scroll", this.sync);
            window.removeEventListener("resize", this.sync);
          }
        },
        PlayerSheets: {
          mounted() {
            this.open = this.el.classList.contains("is-open");
          },
          updated() {
            const open = this.el.classList.contains("is-open");
            // Opening Ficha starts at the owner's details. Updates while
            // reading a sheet keep its scroll position and disclosure state.
            if (open && !this.open) this.el.scrollTop = 0;
            this.open = open;
          }
        },
        PlayerDraft: {
          mounted() {
            this.input = this.el.querySelector("input[name=text]");
            this.key = this.el.dataset.draftKey;
            this.read = () => {
              try { return sessionStorage.getItem(this.key) || ""; }
              catch (_) { return ""; }
            };
            this.save = () => {
              try {
                if (this.input.value) sessionStorage.setItem(this.key, this.input.value);
                else sessionStorage.removeItem(this.key);
              } catch (_) {}
            };
            this.el.addEventListener("input", this.save);
            this.el.addEventListener("submit", this.save);
            this.handleEvent("action_accepted", ({ text }) => {
              // An acknowledgement must not erase a newer draft written
              // while the previous submission was in flight.
              if (this.read() === text) {
                try { sessionStorage.removeItem(this.key); } catch (_) {}
              }
            });
            const saved = this.read();
            if (saved && !this.input.value && !this.input.disabled) {
              this.input.value = saved;
              this.pushEvent("draft", { text: saved });
            }
          },
          destroyed() {
            this.el.removeEventListener("input", this.save);
            this.el.removeEventListener("submit", this.save);
          }
        }
      };

      const liveSocket = new LiveSocket("/live", Socket, {
        hooks,
        params: { _csrf_token: csrfToken },
      });

      liveSocket.connect();

      // Copy share URL to clipboard when the game fires "copy_url".
      // A non-blocking pixel toast instead of alert(): it must not freeze the
      // table while the game keeps streaming.
      window.addEventListener("phx:copy_url", (e) => {
        const url = window.location.origin + e.detail.url;
        const say = (msg) => {
          const t = document.createElement("div");
          t.className = "copy-toast";
          t.setAttribute("role", "status");
          t.textContent = msg;
          document.body.appendChild(t);
          setTimeout(() => t.remove(), 2400);
        };
        (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject())
          .then(() => say(<%= Phoenix.HTML.raw(Jason.encode!(dgettext("ui", "Enlace copiado — pásaselo a tu grupo"))) %>))
          .catch(() => say(url));
      });
    </script>
  </head>
  <body>
    <nav class="topbar">
      <.link href="/" class="brand" aria-label="Dragonex"><i class="px px-torch" aria-hidden="true"></i><img src="/assets/wordmark.svg" alt="Dragonex" class="brand-mark" width="122" height="30" /></.link>
      <div class={"nav-links#{if @current_user, do: "", else: " is-guest"}"}>
        <.link navigate="/">{dgettext("ui", "Partidas")}</.link>
        <.link navigate="/heroes">{dgettext("ui", "Héroes")}</.link>
        <%= if @current_user do %>
          <.link navigate="/cuenta" class="user-tag" title={dgettext("ui", "Tu cuenta")}><i class="px px-shield" aria-hidden="true"></i><span class="user-name">{@current_user.display_name}</span></.link>
          <form id="logout-form" action="/logout" method="post">
            <input type="hidden" name="_method" value="delete" />
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <button type="submit">{dgettext("ui", "cerrar sesión")}</button>
          </form>
        <% else %>
          <.link navigate="/login">{dgettext("ui", "Entrar")}</.link>
          <.link navigate="/register">{dgettext("ui", "Registro")}</.link>
        <% end %>
      </div>
      <% current_locale = Dragonex.I18n.locale() %>
      <div class="lang-switch" role="group" aria-label={dgettext("ui", "Idioma")}>
        <a :for={{code, label, name} <- [{:es, "ES", "Español"}, {:en, "EN", "English"}]}
           href={"/locale/#{code}"} hreflang={code} lang={code} title={name}
           class={if current_locale == code, do: "is-current"}
           aria-current={if current_locale == code, do: "true"}>{label}</a>
      </div>
    </nav>
    <%= @inner_content %>
  </body>
</html>
