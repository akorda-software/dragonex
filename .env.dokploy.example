# Plantilla — copia a .env.dokploy y rellena los TODO.
# .env.dokploy está gitignored (contiene secretos).

# 1. Instancia Dokploy
DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=

# 2. Proyecto / app
PROJECT_NAME=dragonex
PROJECT_DESCRIPTION="Dragonex — D&D con IA"
ENV_NAME=production
APP_NAME=dragonex
APP_DESCRIPTION="Phoenix + ExAgent"

# 3. GitHub
GITHUB_OWNER=kukapu
GITHUB_REPO=dragonex
GITHUB_BRANCH=master
GITHUB_BUILD_PATH=
GITHUB_ID=

# 4. Postgres (contenedor separado)
DB_NAME=dragonex-db
DB_DATABASE_NAME=dragonex_prod
DB_USER=dragonex
# Genera uno seguro: openssl rand -base64 32 | tr -d '=$!'"'"'\\/ '
DB_PASSWORD=

# 5. Dominio
DOMAIN_HOST=dragonex.example.com
DOMAIN_PORT=4000
DOMAIN_HTTPS=true
PHX_HOST=dragonex.example.com

# 6. Secretos de la app
# Genera con: mix phx.gen.secret
SECRET_KEY_BASE=

# 7. IA. En producción la casa solo paga deepseek/deepseek-v4.1-flash por
#    OpenRouter (OPENROUTER_API_KEY), en el proveedor más barato; otros modelos
#    exigen la clave del jugador (Tu cuenta). DRAGONEX_SERVER_MODELS=open deja
#    elegir cualquier modelo con las claves del servidor (solo para pruebas).
#    Las claves de los jugadores se cifran con SECRET_KEY_BASE: rotarlo las
#    invalida (D242).
# DRAGONEX_SERVER_MODELS=fixed
#    DRAGONEX_PROVIDER (openrouter | opencode) solo aplica con =open.
DRAGONEX_PROVIDER=openrouter
# OpenRouter (DRAGONEX_PROVIDER=openrouter):
OPENROUTER_API_KEY=
# Orden preferido de upstream providers (CSV de slugs en minúscula, ver
# https://openrouter.ai/docs/features/provider-routing). Vacío/unset = routing
# por defecto. Sólo aplica con DRAGONEX_PROVIDER=openrouter. Ej:
# OPENROUTER_PROVIDER_ORDER=deepinfra,relace,wafer,together,baseten
# OpenCode Go/Zen (DRAGONEX_PROVIDER=opencode), clave en https://opencode.ai/auth.
# OPENCODE_PLAN: go (suscripción, endpoint .../zen/go/v1) | zen (saldo, .../zen/v1).
# La clave debe corresponder al plan. Default: go.
OPENCODE_PLAN=go
OPENCODE_API_KEY=
