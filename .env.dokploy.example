# Plantilla — copia a .env.dokploy y rellena los TODO.
# .env.dokploy está gitignored (contiene secretos).

# 1. Instancia Dokploy
DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=

# 2. Proyecto / app
PROJECT_NAME=dragones
PROJECT_DESCRIPTION="Dragones — D&D con IA"
ENV_NAME=production
APP_NAME=dragones
APP_DESCRIPTION="Phoenix + ExAgent"

# 3. GitHub
GITHUB_OWNER=kukapu
GITHUB_REPO=dragones
GITHUB_BRANCH=master
GITHUB_BUILD_PATH=
GITHUB_ID=

# 4. Postgres (contenedor separado)
DB_NAME=dragones-db
DB_DATABASE_NAME=dragones_prod
DB_USER=dragones
# Genera uno seguro: openssl rand -base64 32 | tr -d '=$!'"'"'\\/ '
DB_PASSWORD=

# 5. Dominio
DOMAIN_HOST=dragones.example.com
DOMAIN_PORT=4000
DOMAIN_HTTPS=true
PHX_HOST=dragones.example.com

# 6. Secretos de la app
# Genera con: mix phx.gen.secret
SECRET_KEY_BASE=

# 7. IA — proveedor de modelos. Selecciona el gateway (openrouter | opencode).
#    DRAGONES_PROVIDER por defecto es openrouter.
DRAGONES_PROVIDER=openrouter
# OpenRouter (DRAGONES_PROVIDER=openrouter):
OPENROUTER_API_KEY=
# OpenCode Go/Zen (DRAGONES_PROVIDER=opencode), clave en https://opencode.ai/auth.
# OPENCODE_PLAN: go (suscripción, endpoint .../zen/go/v1) | zen (saldo, .../zen/v1).
# La clave debe corresponder al plan. Default: go.
OPENCODE_PLAN=go
OPENCODE_API_KEY=
